# Ansible managed — OPS-585 zwave-js-ui-host role
# Z-Wave JS UI environment — sourced by systemd EnvironmentFile directive.
# Contains Z-Wave network security keys (fetched from Vault at role run time).
# This file is mode 0640 (zwavejs:zwavejs), never world-readable.
#
# Vault path: {{ zwavejs_vault_path }}
# Upstream: "Backup these keys! ... The network key consists of 32 hexadecimal
# characters." (zwave-js-ui quick-start minimum-settings)

# Z-Wave network security keys (32 hex chars = 128 bits each).
# zwave-js-ui uses these env vars when STORE_DIR is set but no settings.json
# exists yet. They are also written to settings.json on first start.
ZWAVEJS_S0_LEGACY={{ zwavejs_secrets.s0_legacy }}
ZWAVEJS_S2_UNAUTHENTICATED={{ zwavejs_secrets.s2_unauth }}
ZWAVEJS_S2_AUTHENTICATED={{ zwavejs_secrets.s2_auth }}
ZWAVEJS_S2_ACCESS_CONTROL={{ zwavejs_secrets.s2_access_control }}

# Auth token for the WebSocket server (HA Z-Wave JS integration uses this).
# Set in zwave-js-ui settings as the "Auth" field under Z-Wave JS Server.
ZWAVEJS_UI_AUTH_TOKEN={{ zwavejs_secrets.ui_auth_token }}

# Serial port — stable by-id path only.
# Upstream: "Do not use /dev/ttyUSBX serial devices, as those mappings can
# change over time. Instead, use the /dev/serial/by-id/X serial device."
ZWAVEJS_SERIAL_PORT={{ zwavejs_serial_port }}

# Log level (info|debug|warn|error|verbose|silly)
ZWAVEJS_LOG_LEVEL={{ zwavejs_log_level }}
