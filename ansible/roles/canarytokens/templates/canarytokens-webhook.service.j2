[Unit]
Description=Canarytokens webhook alert receiver
Documentation=https://github.com/thinkst/canarytokens-docker
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 {{ canarytokens_dir }}/webhook-receiver.py
WorkingDirectory={{ canarytokens_dir }}
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=canarytokens-webhook

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths={{ canarytokens_log_dir }}

[Install]
WantedBy=multi-user.target
