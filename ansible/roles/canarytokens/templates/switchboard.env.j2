# Canarytokens switchboard.env
# Managed by Ansible — OPS-572
# Env var names verified against upstream switchboard.env.dist
# Mode: 0600 — contains key seed; written to {{ canarytokens_dir }}/src/

# ── Required settings ─────────────────────────────────────────────────────
# Domain switchboard binds to (should match CANARY_DOMAINS)
CANARY_PUBLIC_DOMAIN={{ CANARY_PUBLIC_DOMAIN }}

# WireGuard private key seed — required for WG canary token support
# Generate once: python3 -c "import secrets; print(secrets.token_hex(32))"
# Store in Vault at {{ canarytokens_vault_path }}:wg_private_key_seed
CANARY_WG_PRIVATE_KEY_SEED={{ CANARY_WG_PRIVATE_KEY_SEED }}

LOG_FILE=switchboard.log

# ── Port overrides (match docker-compose.yml port bindings) ────────────────
# DNS channel port (internal; maps to {{ canarytokens_switchboard_dns_port }} on host)
CANARY_CHANNEL_DNS_PORT=5354

# HTTP canary channel port
CANARY_CHANNEL_HTTP_PORT=8083

# ── Alert routing ─────────────────────────────────────────────────────────
# Webhook URL for local alert receiver (writes JSON for Wazuh)
# The webhook receiver listens on loopback; host-mode container networking
# allows container→host connection if docker network is bridge.
# See webhook-receiver.py for the receiver implementation.
# Note: use host.docker.internal or the docker bridge gateway IP if needed.
#ERROR_LOG_WEBHOOK=http://172.17.0.1:{{ canarytokens_webhook_port }}/alert

{% if canarytokens_smtp_enabled %}
# ── SMTP alert settings ────────────────────────────────────────────────────
CANARY_SMTP_USERNAME={{ canarytokens_smtp_username }}
CANARY_SMTP_PASSWORD={{ canarytokens_smtp_password }}
CANARY_SMTP_SERVER={{ canarytokens_smtp_server }}
CANARY_SMTP_PORT={{ canarytokens_smtp_port }}
{% if canarytokens_alert_email_from | length > 0 %}
CANARY_ALERT_EMAIL_FROM_ADDRESS={{ canarytokens_alert_email_from }}
{% endif %}
{% endif %}
