# Canarytokens frontend.env
# Managed by Ansible — OPS-572
# Env var names verified against upstream frontend.env.dist
# Mode: 0600 — contains domain config; written to {{ canarytokens_dir }}/src/

# ── Required settings ─────────────────────────────────────────────────────
# Public IP that canary trips resolve to (DNS A-record + HTTP redirect target)
CANARY_PUBLIC_IP={{ CANARY_PUBLIC_IP }}

# Domain(s) used in generated tokens — must have DNS A-record → CANARY_PUBLIC_IP
CANARY_DOMAINS={{ CANARY_DOMAINS }}

# NXDomain used for DNS canaries (must NOT resolve to anything real)
CANARY_NXDOMAINS={{ CANARY_NXDOMAINS }}

LOG_FILE=frontend.log

# ── Optional 3rd-party alert integrations ─────────────────────────────────
# Uncomment and populate if using cloud enrichment
#CANARY_AWSID_URL=
#CANARY_AZURE_ID_TOKEN_URL=
#CANARY_AZURE_ID_TOKEN_AUTH=
#CANARY_GOOGLE_API_KEY=
