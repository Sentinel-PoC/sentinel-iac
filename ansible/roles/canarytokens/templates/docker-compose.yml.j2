version: '3'
# Canarytokens docker-compose.yml
# Generated by Ansible — OPS-572
# Written to {{ canarytokens_dir }}/src/docker-compose.yml — REPLACES the upstream file.
#
# Why we replace instead of override:
#   Docker Compose override files merge `ports:` additively. Upstream common-services.yml
#   binds switchboard to host ports 25, 3306, 53, 6443, 51820 (all 0.0.0.0). An override
#   would ADD our restricted bindings on top — it does NOT replace the upstream bindings.
#   Replacing this file gives full control over port bindings without additive bleed.
#
# Service structure, volume mounts, and commands taken VERBATIM from upstream:
#   https://github.com/thinkst/canarytokens-docker/blob/master/common-services.yml
#
# Citations from common-services.yml (verbatim):
#   Line  7: image: redis:7.0.10
#   Line 26: command: bash -c "cd frontend; poetry run python -m uvicorn app:app --host 0.0.0.0 --port 8082"
#   Line 45: command: bash -c "cd switchboard; rm -f switchboard.pid; poetry run twistd -noy switchboard.tac --pidfile=switchboard.pid"
#   Line 58: command: /usr/sbin/nginx -c /etc/nginx/nginx.conf -g "daemon off;"
#
# What differs from upstream:
#   - NO `build:` directives — pre-built Docker Hub images only
#   - image tags pinned (frontend/switchboard: sha-pinned; nginx: latest; redis: 7.0.10)
#   - port bindings restricted to specific IP/port (not 0.0.0.0)
#   - switchboard: only DNS + HTTP channels enabled (not SMTP/MySQL/k8s/WireGuard)

services:

  redis:
    restart: always
    # Citation: common-services.yml line 7
    image: {{ canarytokens_redis_image }}
    volumes:
      - ./data:/data/
    container_name: redis
    command: redis-server --appendonly yes --protected-mode no --save 60 1

  frontend:
    restart: always
    # Citation: common-services.yml line 12 — image: thinkst/canarytokens (Docker Hub)
    # No GHCR path. No build: directive.
    image: thinkst/canarytokens:{{ canarytokens_image_tag }}
    ports:
      # Bind only to loopback — Pangolin proxies canarytokens.208.haist.farm → 127.0.0.1:8082
      # with Keycloak ForwardAuth (admin UI not directly internet-accessible)
      - "127.0.0.1:{{ canarytokens_frontend_port }}:8082"
    env_file:
      - frontend.env
    volumes:
      # env files mounted read-only into containers where canarytokens code expects them
      - ./frontend.env:/srv/frontend/frontend.env:ro
      - ./switchboard.env:/srv/switchboard/switchboard.env:ro
      - ./uploads:/uploads/
      - log-volume:/logs
    container_name: frontend
    # Citation: common-services.yml line 26 (verbatim)
    command: bash -c "cd frontend; poetry run python -m uvicorn app:app --host 0.0.0.0 --port 8082"
    depends_on:
      - redis

  switchboard:
    restart: always
    # Citation: common-services.yml line 28 — image: thinkst/canarytokens (Docker Hub)
    # No GHCR path. No build: directive.
    image: thinkst/canarytokens:{{ canarytokens_image_tag }}
    ports:
      # Upstream binds: 25:2500, 3306:3306, 53:5354, 53:5354/udp, 6443:6443, 8083:8083, 51820:51820/udp
      # We bind only the channels we actively use:
      #   DNS canary receiver — non-privileged port (avoids systemd-resolved conflict on :53)
      - "{{ CANARY_PUBLIC_IP }}:{{ canarytokens_switchboard_dns_port }}:5354"
      - "{{ CANARY_PUBLIC_IP }}:{{ canarytokens_switchboard_dns_port }}:5354/udp"
      #   HTTP canary receiver
      - "{{ CANARY_PUBLIC_IP }}:{{ canarytokens_switchboard_http_port }}:8083"
      # SMTP canary (port 25 — disabled by default, may conflict with host MTA)
      # - "{{ CANARY_PUBLIC_IP }}:2500:2500"
    env_file:
      - switchboard.env
    volumes:
      # env files mounted read-only into containers where canarytokens code expects them
      - ./frontend.env:/srv/frontend/frontend.env:ro
      - ./switchboard.env:/srv/switchboard/switchboard.env:ro
      - ./uploads:/uploads/
      - log-volume:/logs
    container_name: switchboard
    # Citation: common-services.yml line 45 (verbatim)
    command: bash -c "cd switchboard; rm -f switchboard.pid; poetry run twistd -noy switchboard.tac --pidfile=switchboard.pid"
    depends_on:
      - redis

  nginx:
    restart: always
    # thinkst/canarytokens_nginx — separate pre-built image (Docker Hub, 1 tag: latest)
    # Verified: hub.docker.com/v2/repositories/thinkst/canarytokens_nginx/tags → count:1, name:latest
    image: {{ canarytokens_nginx_image }}
    ports:
      # Bind to LAN IP — Pangolin proxies through here for the admin UI
      # Upstream binds 0.0.0.0:80; we restrict to our LAN IP.
      - "{{ CANARY_PUBLIC_IP }}:{{ canarytokens_nginx_http_port }}:80"
    depends_on:
      - frontend
      - switchboard
    volumes:
      - ./nginx/conf.d:/etc/nginx/conf.d/
    container_name: nginx
    # Citation: common-services.yml line 58 (verbatim)
    command: /usr/sbin/nginx -c /etc/nginx/nginx.conf -g "daemon off;"

volumes:
  log-volume:
