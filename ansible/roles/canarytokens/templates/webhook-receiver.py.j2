#!/usr/bin/env python3
"""
Canarytokens Webhook Receiver
Managed by Ansible — OPS-572

Receives POST callbacks from the Canarytokens server when a token trips.
Writes structured JSON to {{ canarytokens_alert_log }} for Wazuh to tail.

HARD LIMITS: passive logging only; no reverse-shell, no hack-back.
"""

import json
import logging
import sys
from datetime import datetime, timezone
from flask import Flask, request, jsonify

app = Flask(__name__)

ALERT_LOG = "{{ canarytokens_alert_log }}"

# Configure root logger to suppress Flask noise
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s %(levelname)s %(message)s",
    stream=sys.stdout,
)
logger = logging.getLogger("canarytoken-webhook")


def write_alert(payload: dict) -> None:
    """Append a JSON alert record to the alert log (one JSON object per line)."""
    record = {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "source": "canarytokens",
        "event_type": "token_trip",
        "payload": payload,
    }
    with open(ALERT_LOG, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(record) + "\n")
    logger.info("Alert written: token_id=%s type=%s src_ip=%s",
                payload.get("token", "unknown"),
                payload.get("token_type", "unknown"),
                payload.get("src_ip", "unknown"))


@app.route("/alert", methods=["POST"])
def receive_alert():
    """Accept POST from Canarytokens switchboard."""
    try:
        data = request.get_json(force=True, silent=True)
        if data is None:
            # Fallback for form-encoded bodies
            data = dict(request.form)
        write_alert(data or {})
        return jsonify({"status": "ok"}), 200
    except Exception as exc:  # pylint: disable=broad-except
        logger.error("Failed to write alert: %s", exc)
        return jsonify({"status": "error", "detail": str(exc)}), 500


@app.route("/health", methods=["GET"])
def health():
    return jsonify({"status": "ok"}), 200


if __name__ == "__main__":
    # Bind only to loopback — this service is not exposed externally
    app.run(host="127.0.0.1", port={{ canarytokens_webhook_port }}, debug=False)
