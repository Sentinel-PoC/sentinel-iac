# Rendered by vault-agent at runtime from secret/data/minio/admin (OPS-940).
# This file is a consul-template (ctmpl) source — vault-agent reads it as a
# Go template and writes the rendered output to /run/minio-secrets (tmpfs).
#
# DO NOT edit /run/minio-secrets directly — it is overwritten by vault-agent.
# To change credentials: update secret/minio/admin in Vault.
# vault-agent will re-render within {{ vault_agent_minio_render_interval }}.
{% raw %}{{- with secret "secret/data/minio/admin" }}
MINIO_ROOT_USER="{{ .Data.data.access_key }}"
MINIO_ROOT_PASSWORD="{{ .Data.data.secret_key }}"
{{- end }}{% endraw %}

MINIO_VOLUMES={{ minio_data_dir }}
# SEC-88: --certs-dir enables HTTPS-only on :9000; MINIO_SERVER_URL advertises the FQDN.
MINIO_OPTS=--console-address :{{ minio_console_port }} --certs-dir {{ minio_certs_dir }}
MINIO_SERVER_URL=https://{{ minio_server_url_fqdn }}
{% if minio_oidc_enabled and minio_oidc_client_id %}
# OPS-1046: Guard — only render OIDC block when client_id is non-empty.
# MinIO 2025-09-07 treats MINIO_IDENTITY_OPENID_CLIENT_ID="" as a fatal IAM-init
# error (blocks ALL non-root auth). Previously empty client_id silently skipped OIDC.
# Supply minio_oidc_client_id via --extra-vars or in host_vars; never leave it empty.

# Authentik OIDC — additive SSO; root user auth remains active
MINIO_IDENTITY_OPENID_CONFIG_URL="{{ minio_oidc_config_url }}"
MINIO_IDENTITY_OPENID_CLIENT_ID="{{ minio_oidc_client_id }}"
MINIO_IDENTITY_OPENID_CLIENT_SECRET="{{ minio_oidc_client_secret }}"
MINIO_IDENTITY_OPENID_SCOPES="{{ minio_oidc_scopes }}"
MINIO_IDENTITY_OPENID_REDIRECT_URI_DYNAMIC="on"
MINIO_IDENTITY_OPENID_ROLE_POLICY="{{ minio_oidc_role_policy }}"
MINIO_IDENTITY_OPENID_DISPLAY_NAME="{{ minio_oidc_display_name }}"
{% endif %}
