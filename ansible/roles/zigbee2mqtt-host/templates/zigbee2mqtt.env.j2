# Ansible managed — OPS-585 zigbee2mqtt-host role
# zigbee2mqtt EnvironmentFile — sourced by systemd service.
# Contains MQTT credentials (fetched from Vault at role run time).
# Mode 0640, owner zigbee2mqtt — never world-readable.
#
# Vault path: {{ mqtt_vault_path }}

# MQTT credentials for connecting to local mosquitto broker.
# Referenced in configuration.yaml as ${MQTT_USER} / ${MQTT_PASSWORD}.
MQTT_USER={{ mqtt_secrets.username }}
MQTT_PASSWORD={{ mqtt_secrets.password }}

# Data directory (matches ZIGBEE2MQTT_DATA env var).
ZIGBEE2MQTT_DATA={{ zigbee2mqtt_data_dir }}
