// Grafana Alloy configuration for {{ inventory_hostname }}
// Ships systemd journal logs to VictoriaLogs

loki.source.journal "systemd" {
  forward_to    = [loki.write.victorialogs.receiver]
  relabel_rules = loki.relabel.add_host_label.rules
  path          = "/run/log/journal"
  labels        = {
    job  = "systemd-journal",
    host = "{{ inventory_hostname }}",
  }
}

loki.relabel "add_host_label" {
  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "host"
  }
  forward_to = []
}

loki.write "victorialogs" {
  endpoint {
    url = "{{ alloy_victorialogs_url }}"
  }
}
