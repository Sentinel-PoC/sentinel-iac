# {{ ansible_managed }}
[Unit]
Description=OKD etcd backup to MinIO
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
# OPS-285: scoped MinIO creds injected from env file (least-privilege etcd-backup-prod user)
EnvironmentFile=/etc/sentinel/etcd-backup.env
ExecStart=/usr/local/bin/etcd-backup.sh
StandardOutput=journal
StandardError=journal
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
