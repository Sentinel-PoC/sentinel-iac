# {{ ansible_managed }}
# Alertmanager dead-man switch credentials — OPS-915
# Sourced by /usr/local/bin/alertmanager-deadman.sh
# Mode: 0600 root:root — contains Telegram bot token

# Telegram bot credentials
# Token source: secret/telegram/alertmanager-bot (field: api_token)
TELEGRAM_BOT_TOKEN="{{ alertmanager_deadman_telegram_token }}"
TELEGRAM_CHAT_ID="{{ alertmanager_deadman_telegram_chat_id }}"

# KUBECONFIG for oc port-forward (used by the script via source)
KUBECONFIG="{{ alertmanager_deadman_kubeconfig }}"
