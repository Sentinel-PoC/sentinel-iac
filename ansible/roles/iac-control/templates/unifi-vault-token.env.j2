# {{ ansible_managed }}
# [OPS-169] Static Vault address settings for unifi-collector service.
# This file is read by systemd as EnvironmentFile for unifi-collector.service.
# Mode: 0640, owner root:ubuntu.
#
# NOTE: VAULT_TOKEN is intentionally absent from this file.
# It is provided at runtime by vault-agent-unifi-collector.service which
# writes a short-lived, auto-renewed token to {{ vault_agent_unifi_token_path }}.
# See: /etc/vault-agent/unifi-collector.hcl for vault-agent configuration.

VAULT_ADDR={{ unifi_vault_addr }}
VAULT_SKIP_VERIFY={{ unifi_vault_skip_verify }}
