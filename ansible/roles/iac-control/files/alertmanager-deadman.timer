# Ansible managed
[Unit]
Description=Alertmanager Dead-Man Switch Timer — OPS-915
Documentation=https://plane.208.haist.farm — OPS-915
After=network-online.target

[Timer]
# Poll every 30 minutes; offset by 7 minutes to spread timer load on iac-control
OnCalendar=*:07/30
RandomizedDelaySec=60
AccuracySec=30
Persistent=true

[Install]
WantedBy=timers.target
