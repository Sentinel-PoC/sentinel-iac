#!/usr/bin/env bash
# jit-ssh-cert-renew — re-sign id_sentinel.pub via Vault every few hours.
# Uses the long-lived root token at /home/ubuntu/.vault-token (30-day periodic).
# OPS-198: drop-in replacement for the prior manual cert signing pattern that
# let id_sentinel-cert.pub expire on 2026-04-10 and silently break ansible
# runs for a week until HAIST-26 surfaced it.
# OPS-996: also signs claude_jit-root-cert.pub with root,ubuntu,koiakoia principals
# for ansible inventory entries that require root-cert SSH (minio-bootstrap,
# minio-replica). claude_jit is a symlink to id_sentinel (same keypair, different name).
# OPS-470: also signs judge_jit-cert.pub with ubuntu principal when judge_jit.pub is
# present. judge_jit is a separate keypair (not a symlink) — distinct Wazuh/SSH serial
# so Judge SSH actions are auditable separately from claude/worker actions.
set -euo pipefail

VAULT_ADDR="${VAULT_ADDR:-https://vault.208.haist.farm}"
TOKEN_FILE="${VAULT_TOKEN_FILE:-/home/ubuntu/.vault-token}"
PUB_KEY="/home/ubuntu/.ssh/id_sentinel.pub"
CERT_FILE="/home/ubuntu/.ssh/id_sentinel-cert.pub"
CLAUDE_JIT_LINK="/home/ubuntu/.ssh/claude_jit"
CLAUDE_JIT_ROOT_CERT="/home/ubuntu/.ssh/claude_jit-root-cert.pub"
JUDGE_JIT_PUB="/home/ubuntu/.ssh/judge_jit.pub"
JUDGE_JIT_CERT="/home/ubuntu/.ssh/judge_jit-cert.pub"

if [[ ! -s "$TOKEN_FILE" ]]; then
  echo "ERROR: $TOKEN_FILE missing or empty" >&2; exit 1
fi
if [[ ! -s "$PUB_KEY" ]]; then
  echo "ERROR: $PUB_KEY missing or empty" >&2; exit 2
fi

TOKEN="$(cat "$TOKEN_FILE")"

# --- id_sentinel-cert.pub: ubuntu + koiakoia principals (existing behaviour) ---
RESP=$(curl -sk -H "X-Vault-Token: $TOKEN" --request POST \
  --data-urlencode "public_key=$(cat "$PUB_KEY")" \
  --data-urlencode "valid_principals=ubuntu,koiakoia" \
  --data-urlencode "ttl=4h" \
  "${VAULT_ADDR}/v1/ssh/sign/admin")
SIGNED=$(echo "$RESP" | jq -r '.data.signed_key // empty')
if [[ -z "$SIGNED" ]]; then
  echo "ERROR: Vault returned no signed_key (ubuntu cert): $RESP" >&2; exit 3
fi
echo "$SIGNED" > "$CERT_FILE"
chmod 600 "$CERT_FILE"
chown ubuntu:ubuntu "$CERT_FILE"
echo "ok: id_sentinel cert refreshed $(ssh-keygen -L -f "$CERT_FILE" 2>/dev/null | grep -E 'Valid' | head -1 | tr -s ' ')"

# --- claude_jit-root-cert.pub: root + ubuntu + koiakoia principals (OPS-996) ---
# Required by ansible inventory entries for minio-bootstrap, minio-replica, etc.
# that connect as root via Vault-CA cert auth.
RESP_ROOT=$(curl -sk -H "X-Vault-Token: $TOKEN" --request POST \
  --data-urlencode "public_key=$(cat "$PUB_KEY")" \
  --data-urlencode "valid_principals=root,ubuntu,koiakoia" \
  --data-urlencode "ttl=4h" \
  "${VAULT_ADDR}/v1/ssh/sign/admin")
SIGNED_ROOT=$(echo "$RESP_ROOT" | jq -r '.data.signed_key // empty')
if [[ -z "$SIGNED_ROOT" ]]; then
  echo "ERROR: Vault returned no signed_key (root cert): $RESP_ROOT" >&2; exit 4
fi
echo "$SIGNED_ROOT" > "$CLAUDE_JIT_ROOT_CERT"
chmod 600 "$CLAUDE_JIT_ROOT_CERT"
chown ubuntu:ubuntu "$CLAUDE_JIT_ROOT_CERT"
echo "ok: claude_jit-root-cert refreshed $(ssh-keygen -L -f "$CLAUDE_JIT_ROOT_CERT" 2>/dev/null | grep -E 'Valid' | head -1 | tr -s ' ')"

# Ensure claude_jit symlink exists (private key reuse — same keypair as id_sentinel).
# Idempotent: no-op if already present.
if [[ ! -e "$CLAUDE_JIT_LINK" ]]; then
  ln -sf id_sentinel "$CLAUDE_JIT_LINK"
  echo "ok: created symlink claude_jit -> id_sentinel"
fi

# --- judge_jit-cert.pub: ubuntu principal (OPS-470) ---
# judge_jit is a SEPARATE keypair from id_sentinel/claude_jit — different key,
# different SSH serial — so Wazuh/SSH audit logs distinguish Judge SSH actions
# from Worker/claude actions by certificate serial number.
#
# The public key is deployed by Ansible from sentinel-iac IaC (files/judge_jit.pub).
# This block is guarded: if judge_jit.pub is absent, we skip silently so the
# script continues to work on hosts that haven't had the key deployed yet.
if [[ -s "$JUDGE_JIT_PUB" ]]; then
  RESP_JUDGE=$(curl -sk -H "X-Vault-Token: $TOKEN" --request POST \
    --data-urlencode "public_key=$(cat "$JUDGE_JIT_PUB")" \
    --data-urlencode "valid_principals=ubuntu" \
    --data-urlencode "ttl=4h" \
    "${VAULT_ADDR}/v1/ssh/sign/admin")
  SIGNED_JUDGE=$(echo "$RESP_JUDGE" | jq -r '.data.signed_key // empty')
  if [[ -z "$SIGNED_JUDGE" ]]; then
    echo "ERROR: Vault returned no signed_key (judge_jit cert): $RESP_JUDGE" >&2; exit 5
  fi
  echo "$SIGNED_JUDGE" > "$JUDGE_JIT_CERT"
  chmod 600 "$JUDGE_JIT_CERT"
  chown ubuntu:ubuntu "$JUDGE_JIT_CERT"
  echo "ok: judge_jit-cert refreshed $(ssh-keygen -L -f "$JUDGE_JIT_CERT" 2>/dev/null | grep -E 'Valid' | head -1 | tr -s ' ')"
else
  echo "skip: $JUDGE_JIT_PUB absent — judge_jit cert renewal skipped"
fi
