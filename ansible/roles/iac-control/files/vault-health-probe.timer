[Unit]
Description=Probe Vault sealed-state every 5 minutes (OPS-143)

[Timer]
# OnBootSec fires 30s after boot for an initial check.
# OnCalendar=*:0/5 fires every 5 minutes (wall-clock), state-independent.
# Avoid OnUnitActiveSec= for Type=oneshot services — see OPS-214 for why.
# Persistent=true: catches up on missed runs after host sleep/restart.
OnBootSec=30s
OnCalendar=*:0/5
Persistent=true
AccuracySec=10s

[Install]
WantedBy=timers.target
