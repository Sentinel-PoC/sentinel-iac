[Unit]
Description=Harbor image mirror sweep with upstream Cosign verification (SEC-64)
Documentation=https://192.168.12.68/sentinel/sentinel-iac/-/blob/main/docs/runbooks/12-upstream-image-trust.md
After=network-online.target
Wants=network-online.target
ConditionPathExists=/usr/local/bin/harbor-mirror-sweep.sh

[Service]
Type=oneshot
User=root
Environment=HARBOR_REGISTRY=harbor.208.haist.farm
Environment=UPSTREAM_SIG_VERIFY_ENABLED=true
Environment=LOG_EXCEPTION_FILE=/var/log/harbor-mirror-exceptions.log

# Source Cosign key path from environment file (operator-deployed, not Ansible-managed)
# Expected: COSIGN_KEY_PATH=/etc/harbor-cosign/cosign.key
# Expected: COSIGN_KEY_PASSWORD=<redacted>
EnvironmentFile=-/etc/harbor-sweep/env

ExecStart=/usr/local/bin/harbor-mirror-sweep.sh

# Timeouts: a full manifest sweep can take 15+ minutes for large images
TimeoutStartSec=1800

# Log to journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=harbor-sweep

# Do not restart on failure — alert-on-failure is handled by wazuh log monitor
Restart=no

[Install]
WantedBy=multi-user.target
