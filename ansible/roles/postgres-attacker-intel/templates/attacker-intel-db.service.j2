# {{ ansible_managed }}
# [OPS-566] Attacker Intelligence DB systemd service

[Unit]
Description=Attacker Intelligence PostgreSQL+pgvector (OPS-566)
Documentation=https://forgejo.208.haist.farm/sentinel-admin/sentinel-iac
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ attacker_db_compose_dir }}

ExecStart=/usr/bin/docker compose up -d --pull=missing
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose pull && /usr/bin/docker compose up -d

StandardOutput=journal
StandardError=journal
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
