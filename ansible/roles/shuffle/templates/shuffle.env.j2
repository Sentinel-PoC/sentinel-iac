# Shuffle environment file — managed by Ansible (sentinel-iac roles/shuffle)
# Do not edit directly — changes will be overwritten by ansible.
# Tracking: OPS-573
# Mode: 0600 (contains secrets)

# Telegram confirm gate (used by Workflow B: repeat-offender-escalate)
SHUFFLE_TELEGRAM_TOKEN={{ shuffle_telegram_bot_token }}
SHUFFLE_TELEGRAM_CHAT_ID={{ shuffle_telegram_chat_id }}

# Wazuh webhook receiver port (Shuffle listens for Wazuh integration pushes)
{% if shuffle_wazuh_webhook_enabled | bool %}
SHUFFLE_WAZUH_WEBHOOK_PORT={{ shuffle_wazuh_webhook_port }}
{% endif %}
