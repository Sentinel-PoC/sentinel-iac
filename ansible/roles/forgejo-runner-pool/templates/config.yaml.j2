# Ansible managed — OPS-582 forgejo-runner-pool
# Runner: {{ item.name }} (VMID {{ item.vmid }})
# Upstream: https://forgejo.org/docs/next/admin/actions/configuration/
#
# Generated by: ansible/roles/forgejo-runner-pool/templates/config.yaml.j2
# DO NOT edit manually — changes will be overwritten on next playbook run.

log:
  level: info
  job_level: info

runner:
  # Where registration credentials are stored.
  # Created by: forgejo-runner register --no-interactive
  # Contains: id, uuid, name, token, address, labels
  file: .runner

  # Concurrency: 1 job per runner instance.
  # With 3 LXCs + 1 iac-control, the pool can handle 4 concurrent jobs.
  # Increasing capacity adds concurrency within a single LXC; keep at 1
  # to preserve resource isolation between jobs (2 CPU / 4GB RAM per LXC).
  capacity: 1

  # Labels determine which runs-on values this runner accepts.
  # Format: <label-name>:<type> or <label-name>:<type>://<image>
  # Ref: https://forgejo.org/docs/next/admin/actions/configuration/#choosing-labels
  #
  # iac:host          — existing sentinel-iac workflows (runs-on: iac)
  # self-hosted:host  — standard self-hosted target
  # ubuntu-latest:host — GitHub Actions compatibility shim
  # linux:host         — generic linux target
  # cpu-heavy:host    — CPU-intensive jobs (semgrep, trivy, checkov)
  # runner-pve4-N:host — unique per-runner (targeted dispatch)
  # docker:docker://... — Docker-containerised jobs
  labels:
{% for label in item.labels %}
    - "{{ label }}"
{% endfor %}

  # TLS verification for Forgejo instance.
  # OPS-773/OPS-774: forgejo_runner_instance_url is http://forgejo.208.haist.farm:3000
  # (plain HTTP, not HTTPS). insecure: false is still correct for HTTP — it controls
  # whether TLS cert verification is skipped; with plain HTTP there is no TLS to verify.
  # Do NOT change to insecure: true — that would also affect any HTTPS sub-requests.
  insecure: false

  # Job timeout: 3h matches Forgejo server default.
  # Semgrep full-scan and Trivy image scan can run 15-60 min on large repos.
  timeout: 3h
  shutdown_timeout: 3h

  # Poll intervals
  fetch_timeout: 30s
  fetch_interval: 2s
  report_interval: 1s

cache:
  # Artifact cache for actions/cache action support.
  # Default: disabled. Enable when Forgejo cache proxy is configured.
  enabled: false
