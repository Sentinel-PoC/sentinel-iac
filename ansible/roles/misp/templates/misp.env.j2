# MISP environment file — managed by Ansible (sentinel-iac roles/misp)
# Variable names sourced directly from upstream template.env (MISP/misp-docker)
# Do not edit directly — changes will be overwritten.
# Tracking: OPS-571
# WARNING: Mode 0600. This file contains secrets injected from Vault.

# ── Core ────────────────────────────────────────────────────────────────────
# upstream: BASE_URL (template.env L64)
BASE_URL={{ misp_base_url }}

# upstream: ADMIN_EMAIL, ADMIN_ORG, ADMIN_KEY, ADMIN_PASSWORD (template.env L46-54)
ADMIN_EMAIL={{ misp_admin_email }}
ADMIN_ORG={{ misp_org_name }}
ADMIN_KEY={{ misp_admin_key }}
ADMIN_PASSWORD={{ misp_admin_password }}
{% if misp_org_uuid | default('') | length > 0 %}
ADMIN_ORG_UUID={{ misp_org_uuid }}
{% endif %}

# Prevent credentials appearing in container logs
DISABLE_PRINTING_PLAINTEXT_CREDENTIALS=true

# ── MariaDB (MYSQL_* prefix — upstream template.env L128-134) ───────────────
# Service hostname matches docker-compose.yml service name: "db"
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER={{ misp_db_user }}
MYSQL_PASSWORD={{ misp_db_password }}
MYSQL_ROOT_PASSWORD={{ misp_db_root_password }}
MYSQL_DATABASE={{ misp_db_name }}

# ── Redis (upstream template.env L142-150) ───────────────────────────────────
# Service hostname matches docker-compose.yml service name: "redis"
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD={{ misp_redis_password }}

# ── OIDC (upstream template.env L180-196) ────────────────────────────────────
# Variable names are EXACT upstream names. Do not rename.
#   OIDC_ENABLE        (NOT OIDC_LOGIN — that does not exist upstream)
#   OIDC_PROVIDER_URL  (NOT OIDC_PROVIDER)
#   OIDC_ROLES_MAPPING (NOT OIDC_ROLES_MAP)
OIDC_ENABLE={{ misp_oidc_enabled | bool | lower }}
OIDC_PROVIDER_URL={{ misp_oidc_provider_url }}
OIDC_ISSUER={{ misp_oidc_discovery_url }}
OIDC_CLIENT_ID={{ misp_oidc_client_id }}
OIDC_CLIENT_SECRET={{ misp_oidc_client_secret }}
OIDC_ROLES_PROPERTY={{ misp_oidc_roles_property }}
OIDC_ROLES_MAPPING={{ misp_oidc_roles_mapping | to_json }}
OIDC_DEFAULT_ORG={{ misp_org_name }}
OIDC_LOGOUT_URL={{ misp_oidc_logout_url }}
# OIDC_MIXEDAUTH=true allows local login alongside OIDC.
# Set false to enforce SSO-only (no local fallback except console break-glass).
OIDC_MIXEDAUTH={{ misp_oidc_mixed_auth | bool | lower }}
OIDC_SCOPES=["profile", "email"]

# ── Nginx (upstream template.env L370-374) ───────────────────────────────────
# Pangolin reverse proxy sets X-Forwarded-For; enable trust.
NGINX_X_FORWARDED_FOR=true
NGINX_SET_REAL_IP_FROM={{ misp_trusted_proxies }}

# ── PHP tuning ───────────────────────────────────────────────────────────────
PHP_MEMORY_LIMIT=2048M
PHP_MAX_EXECUTION_TIME=300
PHP_UPLOAD_MAX_FILESIZE=50M
PHP_POST_MAX_SIZE=50M

# ── Background updates ───────────────────────────────────────────────────────
ENABLE_DB_SETTINGS=true
ENABLE_BACKGROUND_UPDATES=true
