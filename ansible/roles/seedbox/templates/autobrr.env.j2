# autobrr runtime secrets — deployed by Ansible seedbox role (OPS-321).
# Source of truth: Vault secret/seedbox/autobrr (key: session_secret).
# This file is mode 0600 root:root and is NOT committed to version control.
# Regenerate session_secret with: openssl rand -hex 32
# Then: vault kv put secret/seedbox/autobrr session_secret="<new value>"
AUTOBRR__SESSION_SECRET={{ autobrr_session_secret }}
