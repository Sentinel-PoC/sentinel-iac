# gluetun WireGuard configuration — deployed by Ansible seedbox role (SEC-62).
# This file is mode 0600 root:root and is NOT committed to version control.
# Source of truth: Vault secret/seedbox/wireguard
#
# WireGuard KEY ROTATION PROCEDURE (ProtonVPN custom config):
#   1. Log into ProtonVPN dashboard → VPN → WireGuard → Generate new config
#   2. Download the new .conf file; extract PrivateKey, PublicKey, Address, Endpoint, DNS
#   3. Update Vault:
#        vault kv put secret/seedbox/wireguard \
#          private_key="<PrivateKey from new conf>" \
#          public_key="<PublicKey from new conf>" \
#          addresses="<Address from new conf>" \
#          endpoint_ip="<Endpoint IP from new conf>" \
#          endpoint_port="<Endpoint Port from new conf>" \
#          keepalive_interval="25s" \
#          dns_address="<DNS from new conf>"
#   4. Re-run Ansible: ansible-playbook ansible/playbooks/seedbox-vm.yml
#   5. Verify gluetun healthcheck: docker inspect --format="{{ '{{' }}.State.Health.Status{{ '}}' }}" gluetun
#   6. File git-history rewrite follow-up (see child issue SEC-NNN)
#
# DO NOT edit this file manually — it will be overwritten by Ansible.
# VAULT_ADDR must be set for Ansible lookups: https://192.168.12.206:8200 (direct IP, not Pangolin SSO)

WIREGUARD_PRIVATE_KEY={{ wireguard_private_key }}
WIREGUARD_PUBLIC_KEY={{ wireguard_public_key }}
WIREGUARD_ADDRESSES={{ wireguard_addresses }}
WIREGUARD_ENDPOINT_IP={{ wireguard_endpoint_ip }}
WIREGUARD_ENDPOINT_PORT={{ wireguard_endpoint_port }}
WIREGUARD_PERSISTENT_KEEPALIVE_INTERVAL={{ wireguard_keepalive_interval }}
VPN_DNS_ADDRESS={{ wireguard_dns_address }}
