// cross-seed configuration — generated by Ansible seedbox role (OPS-321 Phase 2).
// Source of truth for Prowlarr API key: Vault secret/seedbox/prowlarr (key: api_key).
// This file is mode 0600 root:root and is NOT committed to version control.
//
// Mounted read-only into cross-seed container at /config/config.js.
// State directory: /config (mapped to {{ cross_seed_config_dir }} on host).
//
// SCOPE: private trackers ONLY (IPTorrents + HD-Space).
// Public trackers (YTS, TPB, EZTV) are excluded — ratio there is irrelevant.
// Prowlarr indexer IDs confirmed 2026-05-03:
//   ID={{ cross_seed_iptorrents_indexer_id }} → IPTorrents (private)
//   ID={{ cross_seed_hdspace_indexer_id }}  → HD-Space  (private)
// If Prowlarr indexers are re-created, IDs may change — update defaults/main.yml.
//
// To switch from dry-run to live injection:
//   1. Inspect saved .torrent files in {{ cross_seed_config_dir }}/cross-seeds/
//   2. If output looks correct, change action to "inject" and re-run Ansible.
//      ansible-playbook -i inventory/hosts.yml site.yml --limit seedbox
//
// To rotate Prowlarr API key:
//   vault kv put secret/seedbox/prowlarr api_key="<new value>"
//   Then re-run the seedbox Ansible role to re-render this file.

export default {
  // ── Source torrents ────────────────────────────────────────────────────────
  // qBit stores .torrent files in its internal BT_backup directory.
  // Mounted read-only from {{ seedbox_qbittorrent_config_dir }}/qBittorrent/BT_backup.
  torrentDir: "/torrents",

  // ── Action ─────────────────────────────────────────────────────────────────
  // "save"   → dry-run: writes matched .torrent files to outputDir, no qBit injection.
  // "inject" → live:    injects matched torrents directly into qBit as already-downloaded.
  //
  // START WITH "save" — review outputDir ({{ cross_seed_config_dir }}/cross-seeds/ on host)
  // before switching to "inject". Operator flips via Ansible re-run after observation.
  //
  // outputDir: null per cross-seed v6 validator guidance (cosmetic warning fix, OPS-321 Phase 2.1).
  action: "save",
  outputDir: null,

  // ── Data matching ──────────────────────────────────────────────────────────
  // dataDirs: directories where actual media files live (same mount as qBit /data).
  // linkType: hardlink — cross-seed creates hardlinks so no extra disk space is used.
  dataDirs: ["/data"],
  linkType: "hardlink",

  // ── qBittorrent client (cross-seed v6+ torrentClients array) ──────────────
  // Replaces deprecated qbittorrentUrl (cosmetic warning fix, OPS-321 Phase 2.1).
  // SEC-73: cross-seed is now in the gluetun network namespace alongside qBit.
  // Both share the namespace — use localhost instead of Docker DNS gluetun:port.
  //
  // OPS-723: credentials ARE required from loopback. qBit's bypass_local_auth defaults
  // to False and its bypass_auth_subnet_whitelist does not include 127.0.0.0/8 by
  // default. Two-layer fix: (1) credentials embedded in URL here, (2) the Ansible task
  // "Configure qBit loopback bypass (OPS-723)" sets bypass_local_auth=True and adds
  // 127.0.0.0/8 to the whitelist so future restarts also work without auth. Belt-and-suspenders.
  torrentClients: ["qbittorrent:http://{{ qbittorrent_username }}:{{ qbittorrent_password }}@localhost:{{ qbittorrent_port }}"],

  // ── Search backend: private trackers ONLY via Prowlarr Torznab ────────────
  // Using torznab URL array (NOT the generic prowlarr integration) to restrict
  // search to IPTorrents + HD-Space only.
  // Public trackers (YTS id=1, TPB id=2, EZTV id=4) are intentionally excluded.
  // SEC-73: prowlarr is also in the gluetun namespace — reachable at localhost:{{ prowlarr_port }}.
  // (Docker DNS name prowlarr:9696 does NOT resolve inside the gluetun namespace.)
  torznab: [
    // IPTorrents — private tracker (Prowlarr indexer ID={{ cross_seed_iptorrents_indexer_id }})
    "http://localhost:{{ prowlarr_port }}/{{ cross_seed_iptorrents_indexer_id }}/api?apikey={{ cross_seed_prowlarr_api_key }}",
    // HD-Space — private tracker (Prowlarr indexer ID={{ cross_seed_hdspace_indexer_id }})
    "http://localhost:{{ prowlarr_port }}/{{ cross_seed_hdspace_indexer_id }}/api?apikey={{ cross_seed_prowlarr_api_key }}",
  ],

  // ── Daemon mode ────────────────────────────────────────────────────────────
  // HTTP API for programmatic trigger. Bound to all interfaces; exposed only on
  // LAN via Docker port mapping {{ cross_seed_port }}:{{ cross_seed_port }}.
  // Not exposed via Pangolin/reverse proxy.
  host: "0.0.0.0",
  port: {{ cross_seed_port }},

  // ── Conservative search cadence ───────────────────────────────────────────
  // searchCadence: how often to auto-scan all torrents (runs inside daemon process).
  // excludeOlder: skip torrents added more than N weeks ago (limits search load).
  // excludeRecentSearch: don't re-search a torrent within this window.
  //
  // cross-seed v6 validator requires:
  //   Rule 1: excludeRecentSearch >= 3 × searchCadence   → 17d >= 3×1d ✓
  //   Rule 2: excludeOlder ∈ [2×, 5×] excludeRecentSearch → 84d ∈ [34d, 85d] ✓
  //
  // excludeRecentSearch raised from "1 day" to "17 days" to satisfy both rules.
  // excludeOlder kept at "12 weeks" (84d) — preserves wide lookback for private trackers
  // where older library content is still actively seeded. (OPS-321 Phase 2.1 fix)
  searchCadence: "1 day",
  excludeOlder: "12 weeks",
  excludeRecentSearch: "17 days",
};
