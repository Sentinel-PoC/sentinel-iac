# {{ ansible_managed }}
# Wazuh Dashboard (OpenSearch Dashboards) configuration
# OPS-631: Authentik OIDC integration

server.host: 0.0.0.0
opensearch.hosts: https://127.0.0.1:9200
server.port: 443
opensearch.ssl.verificationMode: certificate
opensearch.username: kibanaserver
opensearch.password: {{ wazuh_dashboard_kibanaserver_password }}
opensearch.requestHeadersAllowlist: ["securitytenant","Authorization"]
opensearch_security.multitenancy.enabled: false
opensearch_security.readonly_mode.roles: ["kibana_read_only"]
server.ssl.enabled: true
server.ssl.key: "/etc/wazuh-dashboard/certs/wazuh-dashboard-key.pem"
server.ssl.certificate: "/etc/wazuh-dashboard/certs/wazuh-dashboard.pem"
opensearch.ssl.certificateAuthorities: ["/etc/wazuh-dashboard/certs/root-ca.pem"]
uiSettings.overrides.defaultRoute: /app/wz-home
opensearch_security.cookie.secure: true
# Session expiration settings (15 minutes)
opensearch_security.cookie.ttl: 900000
opensearch_security.session.ttl: 900000
opensearch_security.session.keepalive: true

{% if wazuh_oidc_enabled %}
# OpenID Connect SSO via {{ wazuh_oidc_provider_name }}
opensearch_security.auth.type: ["basicauth", "openid"]
opensearch_security.auth.multiple_auth_enabled: true
opensearch_security.openid.connect_url: {{ wazuh_oidc_connect_url }}
opensearch_security.openid.client_id: {{ wazuh_oidc_client_id }}
opensearch_security.openid.client_secret: {{ wazuh_oidc_client_secret }}
opensearch_security.openid.scope: openid profile email groups
opensearch_security.openid.base_redirect_url: https://wazuh.208.haist.farm
opensearch_security.openid.logout_url: {{ wazuh_oidc_logout_url }}
opensearch_security.openid.root_ca: /etc/ssl/certs/ca-certificates.crt
opensearch_security.openid.verify_hostnames: false
opensearch_security.openid.trust_dynamic_headers: true
{% else %}
# OIDC disabled — local auth only
opensearch_security.auth.type: ["basicauth"]
{% endif %}
