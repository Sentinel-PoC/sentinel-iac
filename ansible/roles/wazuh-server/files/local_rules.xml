<!-- Vault probe monitoring (OPS-144 — SEC-44 follow-up #4) -->
<!-- Rule IDs: 100950-100959 -->
<!-- Sources: vault-token-watchdog (vault-server), vault-health-probe (iac-control) -->
<!-- NIST Controls: SI-4 (System Monitoring), AU-2 (Audit Events), SC-28 (Protection at Rest) -->
<group name="vault,probe,">
  <!-- Base rule: any JSON line from vault-token-watchdog -->
  <!-- decoded_as references the parent decoder name (Wazuh reports parent name after JSON_Decoder child) -->
  <rule id="100950" level="3">
    <decoded_as>vault-token-watchdog</decoded_as>
    <description>Vault token watchdog: $(message)</description>
    <group>vault,probe,watchdog,</group>
  </rule>

  <!-- Base rule: any JSON line from vault-health-probe -->
  <rule id="100951" level="3">
    <decoded_as>vault-health-probe</decoded_as>
    <description>Vault health probe: $(message)</description>
    <group>vault,probe,health,</group>
  </rule>

  <!-- Critical: vault-token-watchdog emitted level=critical (token TTL < threshold) -->
  <rule id="100952" level="12">
    <if_sid>100950</if_sid>
    <field name="level">^critical$</field>
    <description>Vault probe critical state — vault-token-watchdog: $(message)</description>
    <group>vault,probe,watchdog,critical,</group>
    <mitre>
      <id>T1552.001</id>
    </mitre>
  </rule>

  <!-- Critical: vault-health-probe emitted level=critical (vault sealed or unreachable) -->
  <rule id="100953" level="12">
    <if_sid>100951</if_sid>
    <field name="level">^critical$</field>
    <description>Vault probe critical state — vault-health-probe: $(message)</description>
    <group>vault,probe,health,critical,</group>
    <mitre>
      <id>T1552.001</id>
    </mitre>
  </rule>

  <!-- Warning: vault-token-watchdog emitted level=warning (token TTL low) -->
  <rule id="100954" level="7">
    <if_sid>100950</if_sid>
    <field name="level">^warning$</field>
    <description>Vault probe warning — vault-token-watchdog: $(message)</description>
    <group>vault,probe,watchdog,warning,</group>
  </rule>

  <!-- Warning: vault-health-probe emitted level=warning (vault on standby or degraded) -->
  <rule id="100955" level="7">
    <if_sid>100951</if_sid>
    <field name="level">^warning$</field>
    <description>Vault probe warning — vault-health-probe: $(message)</description>
    <group>vault,probe,health,warning,</group>
  </rule>

  <!-- =================================================================== -->
  <!-- vault-autounseal-token-ttl monitor (OPS-190 — SEC-44 follow-up) -->
  <!-- Daily check on iac-control: queries Transit Vault for the prod-Vault -->
  <!-- auto-unseal token's remaining lease. WARN < 7d, CRIT < 24h. JSON     -->
  <!-- payload includes status=OK|WARN|CRIT|ERROR + remaining_seconds.      -->
  <!-- Rule IDs: 100956-100958.                                             -->
  <!-- =================================================================== -->
  <rule id="100956" level="3">
    <decoded_as>vault-autounseal-token-ttl</decoded_as>
    <description>Vault auto-unseal token TTL probe: $(message)</description>
    <group>vault,probe,autounseal,</group>
  </rule>

  <!-- OPS-402: was <field name="status">^WARN$</field> — "status" is a reserved static field in Wazuh. -->
  <!-- The emitter emits both status=WARN and level=warning; use level instead (not reserved). -->
  <rule id="100957" level="7">
    <if_sid>100956</if_sid>
    <field name="level">^warning$</field>
    <description>Vault auto-unseal token TTL warning — token expires in $(remaining_human); rotate within the week</description>
    <group>vault,probe,autounseal,warning,</group>
    <mitre>
      <id>T1552.001</id>
    </mitre>
  </rule>

  <!-- OPS-402: was <field name="status">^(CRIT|ERROR)$</field> — same reserved-field issue. -->
  <!-- CRIT and ERROR both emit level=critical in the upstream script; level match is equivalent. -->
  <rule id="100958" level="12">
    <if_sid>100956</if_sid>
    <field name="level">^critical$</field>
    <description>Vault auto-unseal token TTL critical — $(message); SEC-44-class outage imminent without rotation</description>
    <group>vault,probe,autounseal,critical,</group>
    <mitre>
      <id>T1552.001</id>
    </mitre>
  </rule>
</group>

<!-- IaC drift detection (OPS-193) — diff live config vs Ansible/IaC source-of-truth -->
<!-- Daily systemd timer on iac-control. Each rule in rules.yaml emits one JSON line  -->
<!-- per run plus a _summary line. Status field is OK|WARN|CRIT.                      -->
<!-- Rule IDs: 100961-100965.                                                          -->
<!-- NIST: CM-3 (Configuration Change Control), CM-6 (Configuration Settings),         -->
<!--       SI-4 (System Monitoring), AU-2 / AU-12 (Audit Events).                      -->
<group name="iac,drift,">
  <rule id="100961" level="3">
    <decoded_as>iac-drift-check</decoded_as>
    <description>IaC drift check: $(rule_id) status=$(status)</description>
    <group>iac,drift,</group>
  </rule>

  <!-- OPS-402: was <field name="status">^WARN$</field> — "status" is a reserved static field in Wazuh. -->
  <!-- iac-drift-check.py emits plain json.dumps; "status": "WARN" is stable serialisation.        -->
  <!-- Use <match> against the raw JSON log text instead.                                           -->
  <rule id="100962" level="7">
    <if_sid>100961</if_sid>
    <match>"status": "WARN"</match>
    <description>IaC drift WARN — $(rule_id): $(diff)</description>
    <group>iac,drift,warning,</group>
  </rule>

  <!-- OPS-402: was <field name="status">^CRIT$</field> — same reserved-field issue. -->
  <rule id="100963" level="12">
    <if_sid>100961</if_sid>
    <match>"status": "CRIT"</match>
    <description>IaC drift CRIT — $(rule_id): $(diff); Ansible re-run risk or security-posture loss</description>
    <group>iac,drift,critical,</group>
    <mitre>
      <id>T1078</id>
    </mitre>
  </rule>

  <!-- _summary aggregate rule — fires once per check run with totals. -->
  <!-- High-level signal for ops dashboards: any non-zero CRIT/WARN totals across the run. -->
  <!-- OPS-402: replaced <field name="status"> with <match> (same reserved-field reason). -->
  <!-- rule_id is a custom decoded field (not reserved) — <field name="rule_id"> stays.   -->
  <rule id="100964" level="7">
    <if_sid>100961</if_sid>
    <field name="rule_id">^_summary$</field>
    <match>"status": "WARN"</match>
    <description>IaC drift run summary — $(totals.WARN) WARN total this run</description>
    <group>iac,drift,summary,warning,</group>
  </rule>

  <rule id="100965" level="12">
    <if_sid>100961</if_sid>
    <field name="rule_id">^_summary$</field>
    <match>"status": "CRIT"</match>
    <description>IaC drift run summary — $(totals.CRIT) CRIT this run; do NOT re-run Ansible until reconciled</description>
    <group>iac,drift,summary,critical,</group>
    <mitre>
      <id>T1078</id>
    </mitre>
  </rule>
</group>

