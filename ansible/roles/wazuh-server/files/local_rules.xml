<!-- OPS-813: Suppress rule 80710 (NETDEV_CHANGE PROMISC) false positives on Docker bridges -->
<!-- Rule IDs: 100007-100008                                                                  -->
<!-- Context: Docker bridge interfaces (br-* and docker0) enter promiscuous mode as part of  -->
<!-- normal container networking. This is expected/designed Docker behavior, not a threat.   -->
<!-- pangolin-proxy runs Docker (pangolin_default bridge + docker0), generating 80710 alerts -->
<!-- every time Docker manages bridge promisc state. These rules suppress at level 0.        -->
<!-- Scope: all agents — any Docker host legitimately generates these events.                -->
<!-- NIST Controls: SI-4 (System Monitoring) — reducing noise to preserve signal quality     -->
<group name="local,docker,network,">
  <!-- Suppress promiscuous mode alerts for Docker bridge interfaces (br-XXXXXXXX pattern) -->
  <rule id="100007" level="0">
    <if_sid>80710</if_sid>
    <match>dev=br-</match>
    <description>Docker bridge interface (br-*) in promiscuous mode — expected container networking, not a threat (OPS-813)</description>
    <group>docker,network,promisc,</group>
  </rule>

  <!-- Suppress promiscuous mode alerts for docker0 (Docker default bridge) -->
  <rule id="100008" level="0">
    <if_sid>80710</if_sid>
    <match>dev=docker0</match>
    <description>docker0 bridge in promiscuous mode — expected Docker default bridge behavior (OPS-813)</description>
    <group>docker,network,promisc,</group>
  </rule>
</group>

