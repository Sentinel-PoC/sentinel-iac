<!-- OPS-799: pangolin-proxy disk space guard + auditd halt alerting           -->
<!-- Rule IDs: 101001-101003                                                    -->
<!-- Root cause of 2026-05-21 outage: Traefik access logs filled root FS,      -->
<!-- triggering auditd admin_space_left_action=HALT, crashing the VM.          -->
<!-- Two-tier disk alerting from the agent-side command probe (ossec.conf.j2): -->
<!--   101001: ≥70% warn  — level 7  (Discord notification, corrective action)  -->
<!--   101002: ≥85% crit  — level 12 (urgent Discord; HALT imminent at 100%)   -->
<!--   101003: DAEMON_ABORT — level 14 (critical; halt already triggered)       -->
<!-- NIST Controls: SI-4 (System Monitoring), AU-2 (Audit Events)               -->
<group name="local,disk,pangolin,">
  <rule id="101001" level="7">
    <decoded_as>json</decoded_as>
    <field name="event">^pangolin_disk_warn$</field>
    <description>pangolin-proxy: $(filesystem) at $(percent_used)% used — WARNING (70% threshold), Traefik log growth risk (OPS-799)</description>
    <group>disk,pangolin,warning,</group>
  </rule>

  <rule id="101002" level="12">
    <decoded_as>json</decoded_as>
    <field name="event">^pangolin_disk_crit$</field>
    <description>pangolin-proxy: $(filesystem) at $(percent_used)% used — CRITICAL (85% threshold), auditd HALT imminent if not cleared (OPS-799)</description>
    <group>disk,pangolin,critical,</group>
    <mitre>
      <id>T1499.002</id>
    </mitre>
  </rule>
</group>

<!-- OPS-799: pangolin-proxy auditd DAEMON_ABORT alert                          -->
<!-- Rule ID: 101003                                                             -->
<!-- Source: audit localfile in ossec.conf.j2 (pangolin-proxy conditional)      -->
<!-- Fires when auditd replays audit.log after a reboot following a HALT event. -->
<!-- DAEMON_ABORT is the record auditd writes before taking the HALT action.    -->
<!-- Level 14 = critical — this means the disk-full crash already happened.    -->
<!-- NIST Controls: SI-4 (System Monitoring), AU-2 (Audit Events)               -->
<group name="local,audit,pangolin,">
  <rule id="101003" level="14">
    <match>type=DAEMON_ABORT</match>
    <field name="agent.name">^pangolin-proxy$</field>
    <description>pangolin-proxy: auditd DAEMON_ABORT — disk full triggered system halt (OPS-799 root cause event type)</description>
    <group>audit,pangolin,halt,</group>
    <mitre>
      <id>T1499.002</id>
    </mitre>
  </rule>
</group>

<!-- OPS-674: Suppress rule 5904 noise on Ansible-managed hosts -->
<!-- Rule IDs: 101100 -->
<!-- Rule 5904 fires when Wazuh syscheck detects /etc/passwd was modified.      -->
<!-- On this platform all user management is Ansible-driven (ansible.builtin.user -->
<!-- module). Every Ansible run touching user accounts triggers 5904, creating   -->
<!-- alert noise with no security signal. Genuine unauthorized user creation     -->
<!-- appears as rules 5902/5903 (user added/removed), not 5904.                 -->
<!-- Child rule suppresses parent: in Wazuh, when a more-specific child rule     -->
<!-- matches, the parent rule is NOT fired — only the child rule fires.          -->
<!-- Level 3 = informational; below the Discord notification threshold (≥7).    -->
<!-- NIST Controls: SI-4 (System Monitoring), AU-2 (Audit Events)               -->
<group name="local,syscheck,users,">
  <rule id="101100" level="3">
    <if_sid>5904</if_sid>
    <description>User information changed (Ansible-managed host — expected IaC operation, OPS-674)</description>
    <group>syscheck,users,ansible,</group>
  </rule>
</group>

<!-- OPS-708: Suppress rule 80717 noise from AIDE file integrity scans -->
<!-- Rule IDs: 101101 -->
<!-- Rule 80717 fires for auditd ANOM_RBAC_INTEGRITY_FAIL events. On this    -->
<!-- platform the sole trigger is AIDE (/usr/bin/aide) running its scheduled  -->
<!-- integrity scan. AIDE fires ANOM_RBAC_INTEGRITY_FAIL when it detects      -->
<!-- RBAC-metadata changes (file capabilities, ACLs) in tracked files —       -->
<!-- routine churn from package updates on a regularly-patched Ubuntu system. -->
<!-- This is NOT a genuine RBAC violation. The child rule uses an exe= match  -->
<!-- to target AIDE specifically: genuine RBAC failures from other processes  -->
<!-- still fire rule 80717 at level 8.                                        -->
<!-- NIST Controls: SI-4 (System Monitoring), AU-2 (Audit Events)             -->
<group name="local,audit,aide,">
  <rule id="101101" level="3">
    <if_sid>80717</if_sid>
    <match>exe="/usr/bin/aide"</match>
    <description>Auditd RBAC integrity report by AIDE (scheduled scan, OPS-708) — expected platform churn, not a violation</description>
    <group>audit,aide,</group>
  </rule>
</group>

<!-- OPS-248: Suppress rules 5901/5902 noise from Ansible IaC fleet provisioning -->
<!-- Rule IDs: 101102 (new group), 101103 (new user)                              -->
<!-- Rules 5901 (new group added) and 5902 (new user added) fire at level 8 when  -->
<!-- Wazuh detects /etc/group or /etc/passwd additions. On this platform ALL      -->
<!-- user/group management is Ansible-driven (ansible.builtin.user module).       -->
<!-- Every fleet-wide Ansible provisioning run triggers 5901/5902 across hosts,   -->
<!-- creating alert noise with zero security signal — 23 alerts observed across   -->
<!-- vault-server, pangolin-proxy, ns1, ns2, 208-pi-001, iac-control, seedbox-vm. -->
<!-- Mirrors rule 101100 (OPS-674, if_sid 5904 user-info-changed) from PR #277.  -->
<!-- Level 3 = informational; below the Discord notification threshold (>=7).     -->
<!-- NIST Controls: SI-4 (System Monitoring), AU-2 (Audit Events)                 -->
<group name="local,syscheck,users,">
  <!-- Suppress 5901 (new group) from Ansible IaC provisioning runs -->
  <rule id="101102" level="3">
    <if_sid>5901</if_sid>
    <description>New group added by Ansible IaC provisioning (expected fleet operation, OPS-248)</description>
    <group>syscheck,users,ansible,</group>
  </rule>

  <!-- Suppress 5902 (new user) from Ansible IaC provisioning runs -->
  <rule id="101103" level="3">
    <if_sid>5902</if_sid>
    <description>New user added by Ansible IaC provisioning (expected fleet operation, OPS-248)</description>
    <group>syscheck,users,ansible,</group>
  </rule>
</group>

<!-- OPS-279: Suppress rule 5104 noise for Docker veth interface promiscuous mode -->
<!-- Rule IDs: 101104                                                               -->
<!-- NOTE: 101101 is taken by OPS-708 (AIDE); using 101104 as next available ID.   -->
<!-- Rule 5104 fires at level 8 when a network interface enters promiscuous mode.  -->
<!-- Docker veth (virtual ethernet) interfaces legitimately enter promiscuous mode  -->
<!-- as part of container bridge networking — every container start/stop on a      -->
<!-- Docker host generates this event. The 'veth' prefix with a random hex suffix  -->
<!-- (e.g. vethe6f6811) is the kernel naming convention for Docker veth pairs,    -->
<!-- unambiguously identifying virtual interfaces. This is categorically different  -->
<!-- from physical NIC promiscuous mode (which would indicate packet sniffing).    -->
<!-- Wazuh rule 5104 does not distinguish virtual vs. physical interfaces.         -->
<!-- 26 alerts observed from seedbox-vm (docker host), all identical.             -->
<!-- Level 3 = informational; below the Discord notification threshold (>=7).     -->
<!-- NIST Controls: SI-4 (System Monitoring), AU-2 (Audit Events)                 -->
<group name="local,docker,network,">
  <rule id="101104" level="3">
    <if_sid>5104</if_sid>
    <match>veth</match>
    <description>Docker veth interface entered promiscuous mode (expected container bridge behavior, OPS-279)</description>
    <group>docker,network,promisc,</group>
  </rule>
</group>

<!-- OPS-483: iSCSI session loss and NFS stall monitoring on OKD nodes            -->
<!-- Rule IDs: 101105-101108                                                        -->
<!-- Source: iscsid daemon and kernel syslog/journald messages on OKD/CoreOS nodes  -->
<!-- Detects storage-outage precursors: iSCSI session drops and NFS stalls          -->
<!-- before operators notice via "things break" (COMP-3 tabletop gap 3, 2026-05-10) -->
<!-- Level 10: above Discord notification threshold — these are critical storage     -->
<!-- signals. Wazuh MITRE mapping: T1499.002 (Service Exhaustion / storage I/O).   -->
<!-- Syntax: <match> only on free-text log content — no <field> on decoded text     -->
<!-- (avoids the reserved-field trap documented in OPS-823 and OPS-402).            -->
<!-- NIST Controls: SI-4 (System Monitoring), AU-2 (Audit Events), CP-2 (Contingency Plan) -->
<!-- Note on Prometheus NFS alert: node_filesystem_avail_bytes metrics for OKD      -->
<!-- nodes are scraped by the OKD in-cluster Prometheus (not iac-control Prometheus) -->
<!-- — a PrometheusRule CRD in overwatch-gitops is required (tracked: OPS-483).    -->
<group name="local,storage,iscsi,">

  <!-- iSCSI: session or connection failure reported by iscsid daemon               -->
  <!-- Matches iscsid syslog lines indicating session loss or connection failure.    -->
  <!-- Typical patterns: "iscsid: failed to open iscsi_sysfs_path",                 -->
  <!--   "iscsid: Could not log into all portals",                                   -->
  <!--   "iscsid: connection1:0 failed", "iscsid: ping timeout of N secs expired"   -->
  <rule id="101105" level="10">
    <match>iscsid</match>
    <match>error|failed|lost|loss|timeout|could not</match>
    <description>iSCSI: session or connection failure detected by iscsid on OKD node (OPS-483) — storage outage precursor</description>
    <group>storage,iscsi,session_loss,</group>
    <mitre>
      <id>T1499.002</id>
    </mitre>
  </rule>

  <!-- iSCSI: kernel-level connection error                                          -->
  <!-- Matches kernel messages: "Kernel reported iSCSI connection N:M error          -->
  <!--   (1011 - ISCSI_ERR_CONN_FAILED) state (3)"                                  -->
  <rule id="101106" level="10">
    <match>Kernel reported iSCSI connection</match>
    <match>error</match>
    <description>iSCSI: kernel reported connection error on OKD node (OPS-483) — session recovery may be in progress</description>
    <group>storage,iscsi,connection_error,</group>
    <mitre>
      <id>T1499.002</id>
    </mitre>
  </rule>

</group>

<group name="local,storage,nfs,">

  <!-- NFS: stale file handle (ESTALE from NFS client)                              -->
  <!-- Fired when applications on OKD nodes receive ESTALE on a TrueNAS NFS mount.  -->
  <!-- Typical patterns: "stale file handle", "Stale NFS file handle"               -->
  <rule id="101107" level="10">
    <match>stale file handle|Stale file handle|Stale NFS file handle</match>
    <description>NFS: stale file handle on OKD node — TrueNAS NFS mount degraded (OPS-483)</description>
    <group>storage,nfs,stale_handle,</group>
    <mitre>
      <id>T1499.002</id>
    </mitre>
  </rule>

  <!-- NFS: server not responding (mount stall or TrueNAS unreachable)              -->
  <!-- Matches kernel NFS client messages: "nfs: server X not responding, timed out" -->
  <!--   "nfs: server X not responding, still trying"                                -->
  <!--   "NFS: v4 server X not responding, still trying"                             -->
  <rule id="101108" level="10">
    <match>not responding</match>
    <match>nfs|NFS</match>
    <description>NFS: server not responding on OKD node — mount stall or TrueNAS unreachable (OPS-483)</description>
    <group>storage,nfs,server_unreachable,</group>
    <mitre>
      <id>T1499.002</id>
    </mitre>
  </rule>

</group>

<!-- AU-9 SEC-108: Audit log tamper detection via Wazuh syscheck FIM             -->
<!-- Rule IDs: 101200-101201                                                       -->
<!-- MITRE: T1070.002 — Indicator Removal, Clear Linux/Mac System Logs            -->
<!-- Fires on any syscheck event (integrity changed, file added, file deleted,     -->
<!-- permission changed) within the audit log directories monitored via            -->
<!-- ossec.conf.j2 syscheck entries (added SEC-108).                              -->
<!-- Note: the <ignore type="sregex">.log$</ignore> in ossec.conf.j2 suppresses  -->
<!-- per-file audit.log tracking, so these rules catch directory-level changes    -->
<!-- (mtime change when files are added/deleted inside /var/log/audit). Logrotate -->
<!-- may also trigger 101200 — operators should correlate with scheduled runs.    -->
<!-- NIST Controls: AU-9 (Protection of Audit Information)                        -->
<group name="local,audit,tamper,">

  <!-- Alert when syscheck detects any modification in the auditd log directory -->
  <!-- Catches: audit.log deletion, file creation, permission/owner changes      -->
  <rule id="101200" level="12">
    <if_group>syscheck</if_group>
    <match>/var/log/audit</match>
    <description>AU-9 SEC-108: Audit log directory modified — file added, deleted, or permissions changed; investigate for log tampering (T1070.002)</description>
    <group>audit,tamper,syscheck,</group>
    <mitre>
      <id>T1070.002</id>
    </mitre>
  </rule>

  <!-- Alert when syscheck detects any modification in the Vault audit log dir   -->
  <!-- Catches: vault audit.log deletion, file creation, permission/owner changes -->
  <rule id="101201" level="12">
    <if_group>syscheck</if_group>
    <match>/opt/vault/logs</match>
    <description>AU-9 SEC-108: Vault audit log directory modified — file added, deleted, or permissions changed; investigate for log tampering (T1070.002)</description>
    <group>vault,audit,tamper,syscheck,</group>
    <mitre>
      <id>T1070.002</id>
    </mitre>
  </rule>

</group>
