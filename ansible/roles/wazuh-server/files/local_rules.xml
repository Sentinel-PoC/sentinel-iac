    <description>Vault: Authentication failure detected - potential unauthorized access attempt</description>
    <group>authentication_failed,vault,</group>
  </rule>
</group>

<!-- Vault audit log integration (SEC-39) -->
<!-- Rule IDs: 100010-100025 -->
<!-- NIST Controls: AU-2, AU-3, AU-6, AC-2, AC-6, SI-4 -->
<group name="vault,audit,">
  <!-- Base rule: any Vault audit event -->
  <rule id="100010" level="3">
    <decoded_as>json</decoded_as>
    <field name="source">vault-audit</field>
    <description>Vault audit: $(type) — $(request.path)</description>
    <group>vault,audit,</group>
  </rule>

  <!-- Auth login events -->
  <rule id="100011" level="5">
    <if_sid>100010</if_sid>
    <field name="request.path">^auth/</field>
    <field name="type">response</field>
    <description>Vault: Authentication attempt via $(request.path)</description>
    <group>vault,audit,authentication,</group>
  </rule>

  <!-- Secret read operations -->
  <rule id="100012" level="3">
    <if_sid>100010</if_sid>
    <field name="request.operation">read</field>
    <field name="request.path">^secret/</field>
    <description>Vault: Secret read — $(request.path)</description>
    <group>vault,audit,secret_access,</group>
  </rule>

  <!-- Secret write/update operations -->
  <rule id="100013" level="7">
    <if_sid>100010</if_sid>
    <field name="request.operation">update|create</field>
    <field name="request.path">^secret/</field>
    <description>Vault: Secret write — $(request.path) ($(request.operation))</description>
    <group>vault,audit,secret_write,</group>
  </rule>

  <!-- Secret delete operations -->
  <rule id="100014" level="10">
    <if_sid>100010</if_sid>
    <field name="request.operation">delete</field>
    <field name="request.path">^secret/</field>
    <description>Vault: Secret deleted — $(request.path)</description>
    <group>vault,audit,secret_delete,</group>
  </rule>

  <!-- Policy changes -->
  <rule id="100015" level="12">
    <if_sid>100010</if_sid>
    <field name="request.path">^sys/policies/|^sys/policy/</field>
    <field name="request.operation">update|create|delete</field>
    <description>Vault: Policy change — $(request.operation) $(request.path)</description>
    <group>vault,audit,policy_change,</group>
    <mitre>
      <id>T1098</id>
    </mitre>
  </rule>

  <!-- Auth method changes -->
  <rule id="100016" level="12">
    <if_sid>100010</if_sid>
    <field name="request.path">^sys/auth/</field>
    <field name="request.operation">update|create|delete</field>
    <description>Vault: Auth method change — $(request.operation) $(request.path)</description>
    <group>vault,audit,auth_change,</group>
    <mitre>
      <id>T1098</id>
    </mitre>
  </rule>

  <!-- SSH cert signing -->
  <rule id="100017" level="5">
    <if_sid>100010</if_sid>
    <field name="request.path">^ssh/sign/</field>
    <description>Vault: SSH cert signed via $(request.path)</description>
    <group>vault,audit,ssh_signing,</group>
  </rule>

  <!-- Token creation -->
  <rule id="100018" level="5">
    <if_sid>100010</if_sid>
    <field name="request.path">^auth/token/create</field>
    <description>Vault: Token created</description>
    <group>vault,audit,token_create,</group>
  </rule>

  <!-- Root token usage (critical) -->
  <rule id="100019" level="14">
    <if_sid>100010</if_sid>
    <field name="auth.token_type">service</field>
    <field name="auth.policies">root</field>
    <description>Vault: ROOT TOKEN used — $(request.path)</description>
    <group>vault,audit,root_token,</group>
    <mitre>
      <id>T1078.004</id>
    </mitre>
  </rule>

  <!-- Seal/unseal operations -->
  <rule id="100020" level="10">
    <if_sid>100010</if_sid>
    <field name="request.path">^sys/seal$|^sys/unseal$</field>
    <description>Vault: Seal/unseal operation — $(request.path)</description>
    <group>vault,audit,seal,</group>
  </rule>

  <!-- Denied requests (403) -->
  <rule id="100021" level="10">
    <if_sid>100010</if_sid>
    <field name="type">response</field>
    <match>permission denied</match>
    <description>Vault: Permission denied — $(request.path) by $(auth.display_name)</description>
    <group>vault,audit,access_denied,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>
</group>

