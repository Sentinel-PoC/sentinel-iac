# Authentik environment file — managed by Ansible (sentinel-iac roles/authentik-host)
# Variable names sourced from upstream configuration reference:
#   https://docs.goauthentik.io/install-config/configuration/
# Do not edit directly — changes will be overwritten.
# Tracking: OPS-605
# WARNING: Mode 0600. This file contains secrets injected from Vault.

# ── Core secrets ────────────────────────────────────────────────────────────
# AUTHENTIK_SECRET_KEY: used for signing sessions, tokens, and encrypted fields.
# Minimum 50 chars; generate with: openssl rand -base64 60 | tr -d '\n'
# Vault: secret/authentik.secret_key
AUTHENTIK_SECRET_KEY={{ authentik_secret_key }}

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# PG_PASS is read by the postgresql service environment block.
# AUTHENTIK_POSTGRESQL__* are read by the server/worker containers.
# Service hostname "postgresql" matches docker-compose.yml service name.
PG_PASS={{ authentik_db_password }}
PG_DB={{ authentik_db_name }}
PG_USER={{ authentik_db_user }}

# ── Reverse proxy trust ──────────────────────────────────────────────────────
# AUTHENTIK_LISTEN__TRUSTED_PROXY_CIDRS: Pangolin VIP that forwards requests.
# Tells Authentik to trust X-Forwarded-For from these CIDRs.
AUTHENTIK_LISTEN__TRUSTED_PROXY_CIDRS={{ authentik_trusted_proxy_cidrs }}

# ── Error reporting ──────────────────────────────────────────────────────────
# Set false to disable Sentry telemetry to Authentik Security Inc.
AUTHENTIK_ERROR_REPORTING__ENABLED={{ authentik_error_reporting_enabled | bool | lower }}

# ── Email (optional — configure post-deploy in admin UI) ────────────────────
# AUTHENTIK_EMAIL__HOST, AUTHENTIK_EMAIL__PORT, AUTHENTIK_EMAIL__FROM etc.
# Leave unset for initial deploy; operator configures via admin UI or future
# Vault secret expansion in a subsequent PR.

# ── Bootstrap (first-run admin account) ─────────────────────────────────────
# AUTHENTIK_BOOTSTRAP_* vars are only consumed on first startup when no
# akadmin account exists yet. They have no effect once the account is created.
# Ref: https://docs.goauthentik.io/install-config/configuration/#authentik_bootstrap_password
# Vault: secret/authentik.admin_password, .admin_token, .admin_email
AUTHENTIK_BOOTSTRAP_EMAIL={{ authentik_admin_email }}
AUTHENTIK_BOOTSTRAP_PASSWORD={{ authentik_admin_password }}
AUTHENTIK_BOOTSTRAP_TOKEN={{ authentik_admin_token }}

# ── Ports ────────────────────────────────────────────────────────────────────
# COMPOSE_PORT_HTTP / COMPOSE_PORT_HTTPS: passed through to compose port mapping.
# These match authentik_http_port / authentik_https_port in defaults/main.yml.
COMPOSE_PORT_HTTP={{ authentik_http_port }}
COMPOSE_PORT_HTTPS={{ authentik_https_port }}
